# Native (default): local SQLite, no Docker/Redis required
# DATABASE_URL=sqlite+aiosqlite:///./backend/litscope.db
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_HOURS=6
REFRESH_MODE=inline

# Optional: switch to PostgreSQL if you have it
# DATABASE_URL=postgresql+asyncpg://litscope:litscope@localhost:5432/litscope

# Academic APIs
CROSSREF_MAILTO=your-email@example.com
SEMANTIC_SCHOLAR_API_KEY=

# Only needed for Docker Compose / Celery path
# POSTGRES_DB=litscope
# POSTGRES_USER=litscope
# POSTGRES_PASSWORD=litscope
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BACKEND_PORT=8000
# FRONTEND_PORT=3000
# APP_SECRET_KEY=change-me-in-production
# TOPIC_REFRESH_CRONTAB=0 */6 * * *
